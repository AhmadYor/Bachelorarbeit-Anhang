POSTGRES_USER=root
POSTGRES_PASSWORD=p1
POSTGRES_DB=n8n

N8N_ENCRYPTION_KEY=secret-key
N8N_USER_MANAGEMENT_JWT_SECRET=secret
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

# ===== LDAP / Active Directory =====
LDAP_SERVER_HOST=
LDAP_SERVER_PORT=
LDAP_USE_TLS=true
LDAP_VALIDATE_CERT=false
LDAP_APP_DN=
LDAP_APP_PASSWORD=
LDAP_SEARCH_BASE=
# Login nur für Mitglieder von Management ODER Industriesoftware
LDAP_SEARCH_FILTERS=(|(memberOf=CN=Management,OU=Gruppen,OU=MARHRO,DC=MARHRO,DC=LOCAL)(memberOf=CN=Industriesoftware,OU=Gruppen,OU=MARHRO,DC=MARHRO,DC=LOCAL))


# For Mac users running OLLAMA locally
# See https://github.com/n8n-io/self-hosted-ai-starter-kit?tab=readme-ov-file#for-mac--apple-silicon-users
# OLLAMA_HOST=host.docker.internal:11434


