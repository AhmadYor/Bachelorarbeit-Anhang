        "jsCode": "const body = $json.body || {};\nconst question = body.chatInput || body.question || '';\n\n// Zeitpunkt/Datum im Format TT.MM.JJJJ, TT.MM.JJ, YYYY-MM-DD oder MM/DD/YYYY\n// (zuerst erkennen, damit Tag/Monat/Jahr unten nicht faelschlich als Auftragsnummer erkannt werden)\nconst dateMatch = question.match(/\\b(?:\\d{1,2}\\.\\d{1,2}\\.(?:\\d{4}|\\d{2})|\\d{4}-\\d{1,2}-\\d{1,2}|\\d{1,2}\\/\\d{1,2}\\/\\d{4})\\b/);\nconst zeitpunkt = dateMatch ? dateMatch[0] : null;\nconst questionOhneDatum = zeitpunkt ? question.replace(zeitpunkt, ' ') : question;\n\n// Auftragsnummer: beliebig lange Zahl, egal ob 6-, 7-, 8-stellig etc.\n// Bevorzugt eine Zahl die direkt bei \"Auftrag\"/\"Auftragsnummer\" steht,\n// sonst die erste laengere Zahl (>= 4 Stellen) in der Frage.\nconst explicitMatch = questionOhneDatum.match(/Auftrag(?:s?nummer)?\\s*(?:nr\\.?|nummer)?\\s*:?\\s*(\\d+)/i);\nconst genericMatch = questionOhneDatum.match(/\\b\\d{4,}\\b/);\nconst orderNumber = explicitMatch ? explicitMatch[1] : (genericMatch ? genericMatch[0] : null);\n\nlet searchQuery;\nif (orderNumber) {\n  // Auftragsnummer ist der Haupt-Suchbegriff, Datum grenzt zusaetzlich ein wenn genannt.\n  // -dir:Vertraege haelt Werkvertraege draussen: die enthalten dieselbe Projektnummer\n  // und das Wort Leistungsnachweis (z. B. in der Abnahme-Pruefliste).\n  const terms = ['-dir:Vertraege', 'Leistungsnachweis', orderNumber];\n  if (zeitpunkt) terms.push(zeitpunkt);\n  searchQuery = terms.join(' AND ');\n} else {\n  // Fallback: keine Auftragsnummer erkannt -> allgemeine Stichwortsuche\n  const stopwords = new Set([\n    'seit','wann','gilt','wie','was','wer','wo','warum','welche','welcher','welches',\n    'der','die','das','dem','den','des','ein','eine','einer','einem','einen','eines',\n    'und','oder','ist','sind','war','wurde','wird','hat','haben','hatte','hatten',\n    'fuer','fur','von','zu','mit','bei','an','auf','in','im','am','ab','bis','nach',\n    'nicht','auch','noch','schon','dann','wenn','aber','doch','nur','als','ob',\n    'kann','koennen','konnen','muss','muessen','mussen','soll','sollen','darf','duerfen','durfen',\n    'sich','es','er','sie','wir','ihr','dieser','diese','dieses','diesen','diesem',\n    'mir','mich','bitte','zeig','zeige','gib','finde','mal','mich'\n  ]);\n\n  const keywords = question\n    .replace(/[?!.,;:()[\\]]/g, '')\n    .split(/\\s+/)\n    .filter(w => w.length > 1 && !stopwords.has(w.toLowerCase()));\n\n  searchQuery = keywords.length > 0\n    ? '-dir:Vertraege AND Leistungsnachweis AND (' + keywords.join(' OR ') + ')'\n    : '-dir:Vertraege AND Leistungsnachweis';\n}\n\nreturn [{ json: { question, orderNumber, zeitpunkt, searchQuery } }];"
      },
