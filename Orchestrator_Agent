    {
      "parameters": {
        "jsCode": "const superSteps = $input.first().json.intermediateSteps || [];\n\nlet allSteps = [...superSteps];\n\nlet sqlResult = null;\nlet fileResult = null;\n\nfor (const step of superSteps) {\n\n  const tool = step.action?.tool || '';\n  const output = step.observation || '';\n\n  // ---------- SQL ----------\n  if (tool === 'SQL_Agent') {\n\n    try {\n\n      let parsed = JSON.parse(output);\n\n      if (Array.isArray(parsed)) {\n        parsed = parsed[0];\n      }\n\n      sqlResult = parsed;\n\n      // Subworkflow intermediateSteps hinzufügen\n      if (parsed.intermediateSteps) {\n\n        for (const subStep of parsed.intermediateSteps) {\n\n          allSteps.push({\n            ...subStep,\n            parentTool: 'SQL_Agent'\n          });\n\n        }\n      }\n\n    } catch(e) {\n\n      sqlResult = {\n        response: output\n      };\n\n    }\n  }\n\n  // ---------- Dateisuche ----------\n  if (tool === 'Dateisuche') {\n\n    try {\n\n      let parsed = JSON.parse(output);\n\n      if (Array.isArray(parsed)) {\n        parsed = parsed[0];\n      }\n\n      fileResult = parsed.response ?? parsed.output ?? output;\n\n      // Subworkflow intermediateSteps hinzufügen\n      if (parsed.intermediateSteps) {\n\n        for (const subStep of parsed.intermediateSteps) {\n\n          allSteps.push({\n            ...subStep,\n            parentTool: 'Dateisuche'\n          });\n\n        }\n      }\n\n    } catch(e) {\n\n      fileResult = output;\n\n    }\n  }\n}\n\n// ---------- Final Output ----------\n\nif (sqlResult && fileResult) {\n\n  return [{\n    json: {\n      response: fileResult,\n      sql_query: sqlResult.sql_query,\n      data: sqlResult.data,\n      visualization: sqlResult.visualization,\n      intermediateSteps: allSteps\n    }\n  }];\n\n}\n\nif (sqlResult) {\n\n  return [{\n    json: {\n      ...sqlResult,\n      intermediateSteps: allSteps\n    }\n  }];\n\n}\n\nif (fileResult) {\n\n  return [{\n    json: {\n      response: fileResult,\n      intermediateSteps: allSteps\n    }\n  }];\n\n}\n\nreturn [{\n  json: {\n    response: $input.first().json.output,\n    intermediateSteps: allSteps\n  }\n}];"
      },
