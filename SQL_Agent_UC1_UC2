        "jsCode": "// Baut die SQL-Anfrage fuer den naechsten Ausfuehrungsversuch.\n// Lauf 0  -> Input kommt vom \"AI Agent\"\n// Lauf 1+ -> Input kommt vom \"SQL Repair Agent\" (Schleife)\n// Mode: Run Once for All Items\n\nconst MAX_ATTEMPTS = 4;          // <- hier die maximale Anzahl SQL-Versuche einstellen\nconst attempt = $runIndex + 1;   // $runIndex zaehlt die Laeufe dieses Nodes = Versuchszaehler\n\nconst input = $input.first()?.json ?? {};\nconst payload = (input.output && typeof input.output === 'object') ? input.output : input;\n\nlet sql = String(payload.sql_query ?? '');\n\n// Markdown-Fences und Whitespace entfernen\nsql = sql.replace(/^\\s*```[a-z]*\\s*/i, '').replace(/```\\s*$/, '').trim();\n\n// Fuehrende Kommentare ueberspringen, um das erste Schluesselwort zu finden\nconst head = sql.replace(/^(?:\\s|--[^\\n]*\\n|\\/\\*[\\s\\S]*?\\*\\/)+/, '').toLowerCase();\nconst startsReadOnly = head.startsWith('select') || head.startsWith('with');\nconst multiStatement = sql.replace(/;\\s*$/, '').includes(';');\n\nlet blockReason = null;\nif (!sql) {\n  blockReason = 'Der Agent hat keine SQL-Abfrage geliefert.';\n} else if (!startsReadOnly) {\n  blockReason = 'Nur lesende Abfragen (SELECT / WITH) sind erlaubt.';\n} else if (multiStatement) {\n  blockReason = 'Mehrere SQL-Statements in einer Abfrage sind nicht erlaubt.';\n}\n\nreturn [{\n  json: {\n    sql_query: sql,\n    attempt: attempt,\n    max_attempts: MAX_ATTEMPTS,\n    blocked: blockReason !== null,\n    block_reason: blockReason,\n    fix_note: payload.fix_note ?? ''\n  }\n}];\n"
