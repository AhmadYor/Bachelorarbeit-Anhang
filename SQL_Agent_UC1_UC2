        "jsCode": "// Sammelt Fehlermeldung + alle bisherigen Versuche und baut daraus den Prompt\n// fuer den \"SQL Repair Agent\".\n// Laeuft genau einmal pro fehlgeschlagenem SQL-Versuch -> $runIndex = Versuchsindex.\n// Mode: Run Once for All Items\n\nconst attemptIdx = $runIndex;      // 0 = erster Fehlschlag\nconst attempt = attemptIdx + 1;\n\nfunction normalizeError(j) {\n  const e = j?.error ?? j?.message ?? j;\n  if (!e) return '';\n  if (typeof e === 'string') return e;\n  return e.message || e.description || JSON.stringify(e);\n}\n\nfunction reqOfRun(r) {\n  try { return $('Build SQL Request').all(0, r)[0].json; } catch (e) { return null; }\n}\n\nfunction errOfRun(r) {\n  // Branch 1 des SQL-Nodes = Error-Output\n  try { return normalizeError($('Microsoft SQL').all(1, r)[0].json); } catch (e) { return ''; }\n}\n\nconst req = reqOfRun(attemptIdx) || {};\nconst MAX_ATTEMPTS = req.max_attempts || 4;\n\nconst history = [];\nfor (let r = 0; r <= attemptIdx; r++) {\n  const rq = reqOfRun(r);\n  history.push({\n    attempt: r + 1,\n    sql: rq ? rq.sql_query : '',\n    error: errOfRun(r)\n  });\n}\n\n// Aktueller Fehler bevorzugt direkt aus dem Input dieses Nodes\nconst current = normalizeError($input.first()?.json) || history[attemptIdx].error;\nhistory[attemptIdx].error = current;\n\n// Urspruengliche Nutzerfrage (Webhook oder Chat-Trigger)\nlet question = '';\ntry { question = $('Webhook').first().json.body.chatInput; } catch (e) { /* kein Webhook-Lauf */ }\nif (!question) {\n  try { question = $('When chat message received').first().json.chatInput; } catch (e) { /* kein Chat-Lauf */ }\n}\n\nconst blocks = history.map(h =>\n  '### Versuch ' + h.attempt + '\\n```sql\\n' + h.sql + '\\n```\\nFehlermeldung:\\n' + (h.error || '(unbekannt)')\n).join('\\n\\n');\n\nconst repairPrompt = [\n  'Die folgende T-SQL-Abfrage ist auf dem Microsoft SQL Server fehlgeschlagen.',\n  '',\n  '## Urspruengliche Nutzerfrage',\n  question || '(nicht verfuegbar)',\n  '',\n  '## Bisherige Versuche',\n  blocks,\n  '',\n  'Das war Versuch ' + attempt + ' von ' + MAX_ATTEMPTS + '.',\n  'Analysiere die Fehlermeldung und liefere EINE korrigierte, lauffaehige T-SQL-SELECT-Abfrage.',\n  'Wiederhole keinen der oben gezeigten Fehler.'\n].join('\\n');\n\nreturn [{\n  json: {\n    attempt: attempt,\n    max_attempts: MAX_ATTEMPTS,\n    can_retry: attempt < MAX_ATTEMPTS,\n    sql_query: req.sql_query || '',\n    error_message: current,\n    attempts: history,\n    repair_prompt: repairPrompt\n  }\n}];\n"
