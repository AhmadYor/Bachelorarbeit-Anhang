    {
      "parameters": {
        "jsCode": "// Code Node v7: Merged-Input vom Merge-Node + Aggregat-Erkennung + Fehlerpfad\n// Input[0] = AI Agent output (sql_query, response, visualization-Metadaten)\n// Input[1] = SQL-Rohzeilen ODER Fehler-Item aus \"Build Error Response\"\n// Mode: Run Once for All Items\n\nconst all = $input.all();\n\n// Agent-Item: hat einen \"output\"-Wrapper mit sql_query/response\nconst agentItem = all.find(i =>\n  i.json?.output && typeof i.json.output === 'object' &&\n  ('sql_query' in i.json.output || 'response' in i.json.output)\n);\nconst meta = agentItem?.json?.output || {};\n\n// Fehler-Item aus dem Fehlerpfad\nconst failItem = all.find(i => i.json?.__sql_failed === true);\n\n// Interpretation-Item aus dem Pandas+lokale-LLM-Zweig (nur bei Erfolg mit Daten vorhanden)\nconst interpItem = all.find(i => i.json?.__interpretation === true);\n\n// Zuletzt gebaute Query ermitteln (beruecksichtigt Reparaturversuche)\nfunction lastRequest() {\n  for (let r = 9; r >= 0; r--) {\n    try {\n      const items = $('Build SQL Request').all(0, r);\n      if (items && items.length) return items[0].json;\n    } catch (e) { /* dieser Lauf existiert nicht */ }\n  }\n  return null;\n}\nconst req = lastRequest();\nconst effectiveSql = failItem?.json?.sql_query || req?.sql_query || meta.sql_query || '';\nconst usedAttempts = req?.attempt || 0;\n\n// ---------- Fehlerpfad ----------\nif (failItem) {\n  // Agent-Antwort und Fehlertext zu einem Text zusammenfassen\n  const agentText = String(meta.response || '').trim();\n  const errText   = String(failItem.json.error_text || 'Die Abfrage ist fehlgeschlagen.').trim();\n  const combined  = [agentText, errText].filter(Boolean).join('\\n\\n');\n\n  return [{\n    json: {\n      sql_query: effectiveSql,\n      response: combined,\n      analysis: '',\n      attempts: failItem.json.attempts || usedAttempts,\n      error: {\n        message: failItem.json.error_message || '',\n        details: failItem.json.attempt_details || []\n      },\n      data: { headers: [], rows: [] },\n      visualization: { type: 'none', title: '', x_label: '', y_label: '', labels: [], values: [] }\n    }\n  }];\n}\n\n// ---------- Erfolgspfad ----------\nconst sqlItems = all.filter(i =>\n  i !== agentItem &&\n  !i.json?.__sql_failed &&\n  !i.json?.__interpretation &&\n  Object.keys(i.json || {}).length > 0\n);\n\nconst pad = n => String(n).padStart(2, '0');\nconst fmtTime = (raw, spanHours) => {\n  const d = new Date(raw);\n  if (Number.isNaN(d.getTime())) return String(raw);\n  if (spanHours <= 24)      return `${pad(d.getHours())}:${pad(d.getMinutes())}`;\n  if (spanHours <= 30 * 24) return `${pad(d.getDate())}.${pad(d.getMonth()+1)}. ${pad(d.getHours())}:${pad(d.getMinutes())}`;\n  return `${pad(d.getDate())}.${pad(d.getMonth()+1)}.${d.getFullYear()}`;\n};\n\nlet headers = [], rows = [];\nif (sqlItems.length > 0) {\n  headers = Object.keys(sqlItems[0].json);\n  rows = sqlItems.map(i => headers.map(h => i.json[h]));\n}\n\n// Query lief fehlerfrei, hat aber 0 Zeilen geliefert -> die vom Agenten VOR\n// der Ausfuehrung geschriebene response passt dann nicht zur Realitaet.\nconst noDataFound = rows.length === 0;\n\nconst viz = meta.visualization || { type: \"none\" };\nlet labels = [], values = [];\n\nif (rows.length > 0 && viz.type && viz.type !== \"none\") {\n\n  // SPEZIALFALL: Ein-Zeilen-Aggregat (z.B. SELECT MIN, MAX, AVG, SUM)\n  // -> Header werden Labels, Zeilenwerte werden Values\n  const isAggregateRow =\n    rows.length === 1 &&\n    headers.length >= 2 &&\n    rows[0].every(v => v != null && v !== '' && !Number.isNaN(Number(v)));\n\n  if (isAggregateRow) {\n    labels = headers.slice();\n    values = rows[0].map(v => Number(v));\n  } else {\n    // Normalfall: jede Zeile = ein Datenpunkt\n    let labelIdx = headers.findIndex(h => /datetime|zeit|time|date/i.test(h));\n    const isTimeAxis = labelIdx !== -1;\n    if (labelIdx === -1) labelIdx = 0;\n    let valueIdx = headers.findIndex(h => /value|wert|avg|average|sum|min|max|count|anzahl|percent|prozent/i.test(h));\n    if (valueIdx === -1) valueIdx = headers.length - 1;\n    if (valueIdx === labelIdx) valueIdx = 1;\n\n    let spanHours = 1;\n    if (isTimeAxis && rows.length > 1) {\n      const f = new Date(rows[0][labelIdx]), l = new Date(rows[rows.length-1][labelIdx]);\n      if (!Number.isNaN(f - l)) spanHours = (l - f) / 3600000;\n    }\n    for (const r of rows) {\n      const v = Number(r[valueIdx]);\n      if (Number.isNaN(v)) continue;\n      labels.push(isTimeAxis ? fmtTime(r[labelIdx], spanHours) : String(r[labelIdx]));\n      values.push(v);\n    }\n  }\n}\n\n// Lokale LLM-Interpretation nur verwenden, wenn sie tatsaechlich Text geliefert hat --\n// sonst bleibt es bei der vom Agenten vorab geschriebenen response (kein Bruch,\n// falls Pandas/Ollama nicht laufen oder das Modell nicht gepullt ist).\nconst hasInterpretation = !noDataFound && interpItem && String(interpItem.json.interpretation_text || '').trim().length > 0;\n\nconst output = {\n  sql_query: effectiveSql,\n  response: noDataFound\n    ? 'Fuer diese Anfrage wurden keine Daten gefunden. Bitte pruefe die Filterkriterien (z. B. Kunde, Zeitraum) oder formuliere die Frage anders.'\n    : (hasInterpretation ? interpItem.json.interpretation_text : (meta.response || \"\")),\n  analysis: hasInterpretation ? (interpItem.json.stats_text || '') : '',\n  attempts: usedAttempts,\n  data: {\n    headers,\n    rows: rows.map(r => r.map(c => c == null ? \"\" : String(c)))\n  },\n  visualization: {\n    type: noDataFound ? 'none' : (viz.type || \"none\"),\n    title: viz.title || \"\",\n    x_label: viz.x_label || \"\",\n    y_label: viz.y_label || \"\",\n    labels,\n    values\n  }\n};\n\nreturn [{ json: output }];\n"
      },
