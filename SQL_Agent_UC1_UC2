    {
      "parameters": {
        "jsCode": "// Baut eine saubere Fehlerantwort, wenn keine gueltige Abfrage ausgefuehrt werden konnte.\n// Eingaenge:\n//   \"Query Blocked?\"   (true-Zweig)  -> Abfrage war nicht lesend / leer / mehrere Statements\n//   \"Retry Possible?\"  (false-Zweig) -> alle Versuche aufgebraucht\n//   \"SQL Repair Agent\" (Error-Output)\n//   \"AI Agent\"         (Error-Output)\n// Mode: Run Once for All Items\n\nconst j = $input.first()?.json ?? {};\n\nconst details = Array.isArray(j.attempts) ? j.attempts : [];\nconst lastSql = j.sql_query || (details.length ? details[details.length - 1].sql : '');\n\nlet reason = j.block_reason || j.error_message || j.error || j.message || 'Unbekannter Fehler';\nif (typeof reason !== 'string') {\n  reason = reason.message || reason.description || JSON.stringify(reason);\n}\n\nconst tried = details.length || j.attempt || 0;\n\nlet text;\nif (j.blocked) {\n  text = 'Die erzeugte Abfrage wurde blockiert: ' + reason;\n} else if (tried > 0) {\n  text = 'Die Datenbankabfrage ist nach ' + tried + ' Versuch' + (tried === 1 ? '' : 'en') + ' fehlgeschlagen.\\n\\n'\n       + 'Letzte Fehlermeldung des SQL Servers:\\n' + reason + '\\n\\n'\n       + 'Bitte formuliere die Frage anders oder grenze Zeitraum bzw. Kennzahl genauer ein.';\n} else {\n  text = 'Die Anfrage konnte nicht verarbeitet werden.\\n\\nFehler:\\n' + reason;\n}\n\nreturn [{\n  json: {\n    __sql_failed: true,\n    error_text: text,\n    error_message: reason,\n    sql_query: lastSql,\n    attempts: tried,\n    attempt_details: details\n  }\n}];\n"
      },
