    {
      "parameters": {
        "jsCode": "// Baut headers/rows aus den rohen SQL-Zeilen (Microsoft SQL, Erfolgszweig) und\n// sammelt Kontext fuer Pandas-Analyse + lokale LLM-Interpretation. \n// parallel zum bestehenden Merge-Zweig (Index 1) und ändert diesen nicht.\n// Mode: Run Once for All Items\n\nconst items = $input.all();\n\nlet headers = [], rows = [];\nif (items.length > 0) {\n  headers = Object.keys(items[0].json);\n  rows = items.map(i => headers.map(h => i.json[h]));\n}\n\nlet question = '';\ntry { question = $('Webhook').first().json.body.chatInput; } catch (e) { /* kein Webhook-Lauf */ }\nif (!question) {\n  try { question = $('When chat message received').first().json.chatInput; } catch (e) { /* kein Chat-Lauf */ }\n}\n\nlet meta = {};\ntry { meta = $('AI Agent').first().json.output || {}; } catch (e) { /* nicht verfuegbar */ }\n\nconst viz = meta.visualization || {};\n\nreturn [{\n  json: {\n    headers,\n    rows,\n    question: question || '',\n    sql_query: meta.sql_query || '',\n    y_label: viz.y_label || '',\n    title: viz.title || ''\n    //has_data: rows.length > 0\n  }\n}];\n"
