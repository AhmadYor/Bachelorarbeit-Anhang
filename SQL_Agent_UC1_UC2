    {
      "parameters": {
        "jsCode": "// Markiert das Ergebnis der lokalen LLM-Interpretation für Merge Inputs.\n// Bei Fehlschlag (Ollama nicht erreichbar, Modell nicht gepullt, leere Antwort)\n// bleibt interpretation_text leer -> Merge Inputs faellt automatisch auf die\n// urspruengliche Agenten-Antwort zurueck.\n// Mode: Run Once for All Items\n\nconst item = $input.first()?.json ?? {};\nconst text = String(item.text ?? item.response?.text ?? item.output ?? '').trim();\n\nlet statsText = '';\ntry { statsText = $('Build Interpretation Prompt').first().json.stats_text || ''; } catch (e) { /* nicht verfuegbar */ }\n\nreturn [{\n  json: {\n    __interpretation: true,\n    interpretation_text: text,\n    stats_text: statsText\n  }\n}];\n"
