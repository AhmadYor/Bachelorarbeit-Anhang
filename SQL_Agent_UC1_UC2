    {
      "parameters": {
        "jsCode": "// Baut den Prompt für die lokale LLM-Interpretation aus Originalfrage,\n// SQL-Query, Pandas-Statistik-Text und einer gekappten Rohdatenvorschau.\n// Mode: Run Once for All Items\n\nconst MAX_PREVIEW_ROWS = 30;\n\nconst ctx = $('Prepare Rows For Analysis').first().json;\n// const statsText = String($json.analysisText || '').trim();\n\nconst previewRows = ctx.rows.slice(0, MAX_PREVIEW_ROWS);\nconst previewLines = [ctx.headers.join(' | '), ...previewRows.map(r => r.join(' | '))];\nconst truncatedNote = ctx.rows.length > MAX_PREVIEW_ROWS\n  ? `\\n... (${ctx.rows.length - MAX_PREVIEW_ROWS} weitere Zeile(n) nicht angezeigt)`\n  : '';\n\nconst promptText = [\n  '## Frage des Controllers',\n  ctx.question || '(nicht verfuegbar)',\n  '',\n  '## SQL-Ergebnis (Datensaetze)',\n  previewLines.join('\\n') + truncatedNote,\n  '',\n  'Interpretiere diese Zahlen fuer einen Controller auf Deutsch. Beziehe dich konkret auf die Datensaetze oben, nicht auf die SQL-Abfrage.'\n].join('\\n');\n\nreturn [{\n  json: {\n    prompt_text: promptText\n  }\n}];\n"
